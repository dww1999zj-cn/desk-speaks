# 阿里云百炼 / 通义千问 API Key
DASHSCOPE_API_KEY=sk-your-key-here

# 视觉模型（qwen-vl-plus；与 FALLBACK 相同时只调一次，不回退）
QWEN_VL_MODEL=qwen-vl-plus

# 通义万相 · 工位效果图
# 推荐：wan2.6-image（替代 wan2.5-i2i-preview，同价 0.20元/张，独立 50 张免费额度）
WANX_EDIT_MODEL=wan2.6-image
WANX_FALLBACK_EDIT_MODEL=wanx2.1-imageedit
# 也支持：wan2.5-i2i-preview / wan2.7-image / wan2.7-image-pro
WANX_IMAGE_SIZE=2K
# i2i / wan2.6 两 pass 每改造多耗 1 次额度
WANX_TWO_PASS=false
# imageedit 单 pass 默认；设为 true 启用收纳→点缀两 pass
WANX_IMAGEEDIT_TWO_PASS=false
WANX_EDIT_STRENGTH=0.55
WANX_ORGANIZE_STRENGTH=0.62
WANX_DECOR_STRENGTH=0.48
# 设为 true 则跳过效果图，仅保留 Qwen 文字方案
# SKIP_WANX_IMAGE=true
# i2i 是否扩展 prompt（默认 false，避免改写掉「不改桌子」约束）
# WANX_PROMPT_EXTEND=true
# 固定随机种子，同一张图结果更稳定（仍非100%一致）
# WANX_SEED=42

USE_MOCK_DATA=true

# 分享图二维码指向的站点（部署后改成你的域名）
NEXT_PUBLIC_SITE_URL=https://desk.zeabur.app

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
